{
  "jobs": ["lint", "types", "go-race", "web-tests", "test-os", "go_win_lint", "build", "image", "e2e-shards"],
  "always_jobs": ["lint"],
  "run_everything": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    "go.mod",
    "go.sum",
    ".github/**",
    "scripts/ci/**",
    "scripts/delivery/**"
  ],
  "docs": ["docs/**", "**/*.md", "LICENSE", ".claude/**", ".delivery/**"],
  "areas": {
    "go": {
      "paths": ["**/*.go", "apps/controller/cmd/**", "apps/controller/internal/**", "sqlc.yaml"],
      "jobs": ["types", "go-race", "web-tests", "test-os", "go_win_lint", "build", "image", "e2e-shards"]
    },
    "windows": {
      "paths": [
        "**/*.syso",
        "apps/controller/cmd/crsp/winres/**",
        "**/*.ps1",
        "**/*.wxs",
        "scripts/install/**",
        "scripts/real-machine/**"
      ],
      "jobs": ["test-os", "go_win_lint", "build"]
    },
    "web": {
      "paths": ["apps/controller-console/**", "packages/**", "scripts/design/**"],
      "jobs": ["types", "web-tests", "build", "image", "e2e-shards"]
    },
    "site": {
      "paths": ["apps/web/**"],
      "jobs": ["types", "web-tests"]
    },
    "guards": {
      "paths": ["guards/**", "tools/design-guards.json", "tsconfig.json", "vitest.config.ts"],
      "jobs": ["types", "web-tests"]
    },
    "e2e": {
      "paths": ["e2e/**", "playwright.config.ts"],
      "jobs": ["types", "build", "e2e-shards"]
    },
    "image": {
      "paths": ["images/**"],
      "jobs": ["build", "image"]
    },
    "installer": {
      "paths": ["installer/**", "packaging/**"],
      "jobs": ["types", "go-race", "web-tests", "test-os", "go_win_lint", "build"]
    },
    "config": {
      "paths": [
        ".golangci.yml",
        ".gitleaks.toml",
        ".gitleaksignore",
        ".prettierrc",
        ".prettierignore",
        ".gitattributes",
        ".gitignore",
        ".nvmrc",
        ".githooks/**",
        ".env.example",
        "Taskfile.yml",
        "pytest.ini",
        "eslint.config.mjs",
        "routines/**"
      ],
      "jobs": []
    }
  }
}
