{
  "schema": 1,
  "track": "go",
  "local_gate": "smoke",
  "default_branch": "main",
  "setup": ["go mod download", "go mod verify", "go list -mod=readonly -m all", "go list -mod=readonly -deps -test ./..."],
  "timeout_minutes": 30,
  "packages": {"kind": "go-modules"},
  "widen_on": [
    "go.work",
    "go.work.sum",
    ".golangci.yml",
    ".github/",
    "scripts/delivery/"
  ],
  "lockfile_scope": "per-package",
  "inert_paths": ["docs/**"],
  "ui_paths": ["apps/controller-console/", "packages/ui/"],
  "e2e_map": {
    "specs": [
      {"spec": "e2e/tests/web-console/pool-jobs.spec.ts", "paths": ["apps/controller-console/src/screens/jobs/"]},
      {"spec": "e2e/tests/web-console/ux-jobs-rows.spec.ts", "paths": ["apps/controller-console/src/screens/jobs/"]},
      {"spec": "e2e/tests/web-console/pool-machines.spec.ts", "paths": ["apps/controller-console/src/screens/machines/"]},
      {"spec": "e2e/tests/web-console/machines-panes.spec.ts", "paths": ["apps/controller-console/src/screens/machines/"]},
      {"spec": "e2e/tests/web-console/registry.spec.ts", "paths": ["apps/controller-console/src/screens/registry/"]},
      {"spec": "e2e/tests/web-console/repositories-panes.spec.ts", "paths": ["apps/controller-console/src/screens/repositories/"]},
      {"spec": "e2e/tests/web-console/runners-images-doctor.spec.ts", "paths": ["apps/controller-console/src/screens/runners/", "apps/controller-console/src/screens/images/", "apps/controller-console/src/screens/doctor/"]},
      {"spec": "e2e/tests/web-console/ux-runners-table.spec.ts", "paths": ["apps/controller-console/src/screens/runners/"]},
      {"spec": "e2e/tests/web-console/notifications.spec.ts", "paths": ["apps/controller-console/src/screens/notices/"]}
    ],
    "full_on": ["playwright.config.ts", "e2e/tests/web-console/fixtures.ts", "e2e/tests/web-console/ux-guards.ts", "packages/ui/", "apps/controller-console/src/shell/", "apps/controller-console/src/App.tsx", "apps/controller-console/src/main.tsx"]
  },
  "fail_fast_order": ["secret-scan", "change-notes", "guards", "lint", "typecheck", "unit"],
  "steps": [
    {
      "name": "secret-scan",
      "scope": "always",
      "pre_push": true,
      "run": "gitleaks git --log-opts={base}..HEAD --redact --no-banner"
    },
    {
      "name": "change-notes",
      "scope": "always",
      "pre_push": true,
      "run": "python3 scripts/delivery/change_notes.py check --base-ref {base} || python scripts/delivery/change_notes.py check --base-ref {base}"
    },
    {
      "name": "guards",
      "scope": "always",
      "pre_push": true,
      "run": "go test -timeout 10s -run \"^TestGuard\" ./..."
    },
    {
      "name": "lint",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "golangci-lint run --timeout=5m ./..."
    },
    {
      "name": "typecheck",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "go vet ./..."
    },
    {
      "name": "unit",
      "scope": "changed",
      "run": "bash scripts/ci/go-test.sh -short"
    },
    {
      "name": "e2e",
      "scope": "ui-changed",
      "run": "{ [ -n \"${E2E_CHROMIUM_PATH:-}\" ] && [ -x \"$E2E_CHROMIUM_PATH\" ]; } || pnpm exec playwright install chromium && pnpm exec playwright test {e2e_specs}",
      "run_full": "{ [ -n \"${E2E_CHROMIUM_PATH:-}\" ] && [ -x \"$E2E_CHROMIUM_PATH\" ]; } || pnpm exec playwright install chromium && pnpm exec playwright test",
      "env": {"CI": "true"}
    }
  ],
  "always_on_guards": [
    {
      "name": "gitleaksignore-no-additions",
      "command": "python3 scripts/ci/gitleaksignore_guard.py --base origin/main",
      "inputs": [".gitleaksignore"]
    }
  ]
}
