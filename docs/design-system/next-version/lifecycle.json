{
  "schema": "1",
  "product": {
    "name": "Crsp",
    "id": "crsp"
  },
  "targets": [
    {
      "os": "windows",
      "distro": null,
      "arch": "x64",
      "package": "msi"
    },
    {
      "os": "windows",
      "distro": null,
      "arch": "arm64",
      "package": "msi"
    }
  ],
  "paths": {
    "windows": {
      "program": "%ProgramFiles%\\crsp",
      "data": "%ProgramData%\\crsp",
      "config": "%ProgramData%\\crsp\\config.toml",
      "logs": "%ProgramData%\\crsp\\logs",
      "service": "crsp"
    }
  },
  "flows": {
    "install": {
      "states": [
        "install",
        "started",
        "setup",
        "ready",
        "install_failed"
      ],
      "transitions": [
        {
          "from": "install",
          "to": "started"
        },
        {
          "from": "started",
          "to": "setup"
        },
        {
          "from": "setup",
          "to": "ready"
        },
        {
          "from": "started",
          "to": "install_failed"
        },
        {
          "from": "setup",
          "to": "install_failed"
        }
      ]
    },
    "update": {
      "states": [
        "unpaired",
        "up_to_date",
        "available",
        "review",
        "waiting",
        "downloading",
        "verifying",
        "refused",
        "installing",
        "testing",
        "updated",
        "rolling_back",
        "rolled_back",
        "skipped"
      ],
      "transitions": [
        {
          "from": "unpaired",
          "to": "up_to_date"
        },
        {
          "from": "up_to_date",
          "to": "available"
        },
        {
          "from": "available",
          "to": "review"
        },
        {
          "from": "available",
          "to": "waiting"
        },
        {
          "from": "review",
          "to": "waiting"
        },
        {
          "from": "review",
          "to": "skipped"
        },
        {
          "from": "waiting",
          "to": "downloading"
        },
        {
          "from": "downloading",
          "to": "verifying"
        },
        {
          "from": "verifying",
          "to": "refused"
        },
        {
          "from": "verifying",
          "to": "installing"
        },
        {
          "from": "installing",
          "to": "testing"
        },
        {
          "from": "testing",
          "to": "updated"
        },
        {
          "from": "testing",
          "to": "rolling_back"
        },
        {
          "from": "rolling_back",
          "to": "rolled_back"
        },
        {
          "from": "rolled_back",
          "to": "waiting"
        },
        {
          "from": "rolled_back",
          "to": "skipped"
        },
        {
          "from": "updated",
          "to": "up_to_date"
        },
        {
          "from": "refused",
          "to": "up_to_date"
        },
        {
          "from": "skipped",
          "to": "up_to_date"
        }
      ]
    },
    "remove": {
      "states": [
        "remove",
        "ask",
        "keep",
        "purge",
        "clean"
      ],
      "transitions": [
        {
          "from": "remove",
          "to": "ask"
        },
        {
          "from": "ask",
          "to": "keep"
        },
        {
          "from": "ask",
          "to": "purge"
        },
        {
          "from": "keep",
          "to": "clean"
        },
        {
          "from": "purge",
          "to": "clean"
        }
      ]
    }
  },
  "defaults": {
    "policy": "automatic_when_idle",
    "idle_window": null,
    "check_hours": 6,
    "check_jitter_pct": 20,
    "first_check_minutes": [
      1,
      10
    ],
    "check_backoff_minutes": [
      1,
      5,
      30,
      120
    ],
    "self_test_limit_s": 180,
    "self_test_poll_s": 2,
    "wait_for_work_minutes": 60,
    "retry_hours": [
      1,
      4
    ],
    "channel": "stable",
    "console_host": "127.0.0.1",
    "telemetry": "off"
  },
  "words": {
    "banned": [
      "OK",
      "Yes",
      "No",
      "Install now",
      "Later",
      "daemon",
      "binary",
      "payload"
    ],
    "states": {
      "menu": {
        "check": "Look for updates"
      },
      "available": {
        "title": "Version {version} is ready.",
        "primary": "Update to version {version}",
        "secondary": "Not now",
        "required": "Version {version} is required and installs now."
      },
      "downloading": {
        "step": "Downloading"
      },
      "verifying": {
        "step": "Checking the download"
      },
      "installing": {
        "step": "Installing"
      },
      "testing": {
        "step": "Testing"
      },
      "updated": {
        "title": "Updated to version {version}.",
        "action": "What's new"
      },
      "rolled_back": {
        "title": "The update to {version} failed its test. Version {previous} is running again. We try again at {time}."
      },
      "refused": {
        "title": "The download for {version} did not pass its signature check. Nothing changed."
      },
      "remove": {
        "title": "Remove {product}",
        "keep": "Keep my data",
        "purge": "Delete my data too ({size} GB in {path})",
        "cancel": "Cancel",
        "confirm": "Remove {product}",
        "confirm_disabled_until": "Choose what happens to your data first."
      },
      "up_to_date": {
        "title": "Crsp is up to date. Version {version}."
      },
      "waiting": {
        "title": "Waiting for {n} running jobs to finish. The update starts when they end."
      },
      "skipped": {
        "title": "Version {version} is skipped. We look again when a newer version is out."
      },
      "unpaired": {
        "title": "Pair this machine first. Crsp looks for updates after that."
      }
    }
  },
  "upgrade_data_rule": {
    "rule": "LC-11",
    "text": "An upgrade from the previous release keeps every config file and every row of the user tables. The one exception is a change a migration declares on purpose in internal/store/declared_changes.go: a table it drops (must be gone, not emptied) or a JSON key it removes from a column of a table (every row must stay, every other cell equal). A declaration applies only when the database before the upgrade is below that migration and the database after is at or above it. The lane prints each accepted change as its own line, 'LC-11 note: declared by migration N (TASK): ...'. Every other loss or change fails; there is no opt-out."
  },
  "keep_on_remove": [
    "data"
  ],
  "test_interface": {
    "self_test": "crsp-lifecycle-test --self-test",
    "state": "crsp-lifecycle-test --lifecycle-state",
    "simulate": "crsp-lifecycle-test --lifecycle-simulate"
  }
}
