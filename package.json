{
  "name": "ci-runners-shared-pool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "codegen": "go tool task codegen",
    "build": "go tool task build",
    "test": "go tool task test",
    "lint": "go tool task lint",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:root",
    "lint:root": "eslint guards e2e playwright.config.ts vitest.config.ts",
    "typecheck:root": "tsc -p guards/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
