<?xml version="1.0" encoding="utf-8"?>
<!--
  The crsp MSI for Windows (operations R5.7), for WiX v5 (pinned in
  dotnet-tools.json). build.ps1 builds it for x64 and arm64 and defines:

    ProductVersion  a.b.c.d for the MSI (build.ps1 maps the release version)
    CrspExe         the crsp.exe to install
    CrspIcon        the app icon (cmd/crsp/winres/crsp.ico): Apps list, Start Menu, installer
    LicenseRtf      the licence text shown by the install dialog
    BannerBmp       WixUIBannerBmp (493x58) and DialogBmp WixUIDialogBmp (493x312): the crsp
                    icon and name in the Phosphor tokens, generated by build.ps1 from
                    packages/ui/src/tokens.css (internal/updatewindow/genart); never hand-made

  What is installed where:
    %ProgramFiles%\crsp    crsp.exe; replaced by every upgrade
    %ProgramData%\crsp     the data folder (R5.10): config.toml, the database,
                           backups, logs, the CA. Administrators and SYSTEM only. Kept by every upgrade and by a
                           silent uninstall; deleted at uninstall only on request: PURGE=1 on msiexec, or
                           "Delete my data too" in the remove window (OPS69).

  The service is `crsp.exe controller` as LocalSystem (R5.4: it manages the
  runner services and accounts and runs the MSI upgrade for auto-update), named "crsp" like internal/tray.ServiceName.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="CI Runners Shared Pool"
           Manufacturer="Luis Carvalho"
           Version="$(var.ProductVersion)"
           UpgradeCode="C1D62442-6DB4-4FF0-9F28-A1CE3121B332"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="CI Runners Shared Pool (crsp)" />

    <!--
      Every release is a major upgrade: the old version is removed and the new
      one installed; the data folder is not the program's to remove. The old
      version is removed inside the new install's transaction (afterInstallInitialize),
      so a failed upgrade rolls back to the old version (the default schedule removes
      it first and cannot put it back). A lower
      version is refused. The same a.b.c replaces itself (edge builds differ
      only in the fourth field, which Windows Installer ignores).
    -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes" />

    <!-- Restart Manager is off: the service and the tray are stopped by this package itself, so no run needs a reboot. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The round CRSP disc (decision tray D8): the icon of the Apps list entry. -->
    <Icon Id="CrspIcon.ico" SourceFile="$(var.CrspIcon)" />
    <Property Id="ARPPRODUCTICON" Value="CrspIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="crsp" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="crsp" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Crsp" Title="crsp" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentGroupRef Id="DataFolder" />
    </Feature>

    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <!-- crsp.exe, the service, its restart policy, the PATH entry and the firewall rule -->
      <Component Id="CrspProgram">
        <File Id="CrspExe" Name="crsp.exe" Source="$(var.CrspExe)" KeyPath="yes" />

        <ServiceInstall Id="CrspService"
                        Name="crsp"
                        DisplayName="CI Runners Shared Pool (crsp)"
                        Description="The crsp controller: web console, API and scheduling for the shared pool of CI runners."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Arguments="controller"
                        Vital="yes">
          <ServiceConfig DelayedAutoStart="yes" FailureActionsWhen="failedToStopOrReturnedError" OnInstall="yes" OnReinstall="yes" />
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Stop waits until the service has ended; Start brings it back after an install or an upgrade. -->
        <ServiceControl Id="CrspServiceControl" Name="crsp" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

        <Environment Id="CrspPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />

        <!-- Inbound, Private profile only (never Public); removed with the product. -->
        <fw:FirewallException Id="CrspFirewall"
                              Name="crsp console and agent link (private networks)"
                              Description="Lets crsp listen on 8460 (console and API) and 8461 (agent link) on private networks."
                              Program="[#CrspExe]"
                              Protocol="tcp"
                              Port="8460,8461"
                              Profile="private"
                              Scope="any" />

        <!--
          The tray starts at every user's sign-in (R5.3). In this component, not its own: the value names
          crsp.exe ([#CrspExe]), and a reference to a file of another component is ICE69.
        -->
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="crsp-tray"
                       Type="string"
                       Value="&quot;[#CrspExe]&quot; tray" />
      </Component>

      <!--
        The Start Menu shortcut opens the tray, in the WiX "create a shortcut on the Start Menu" pattern: a component
        of its own whose key path is an HKCU registry value (ICE43), holding only the shortcut. Not advertised.
        The package is per-machine (Scope="perMachine" writes ALLUSERS=1, so ProgramMenuFolder is the all-users
        Start menu). The target is the CRSPEXE property, not [#CrspExe]: a reference to a file of another
        component is ICE69. build.ps1 / LC-18 print the built MSI's ALLUSERS value.
      -->
      <Component Id="CrspShortcutComponent" Directory="ProgramMenuFolder">
        <Shortcut Id="CrspShortcut"
                  Name="CI Runners Shared Pool"
                  Icon="CrspIcon.ico"
                  Description="CI Runners Shared Pool tray"
                  Target="[CRSPEXE]"
                  Arguments="tray"
                  WorkingDirectory="INSTALLFOLDER"
                  Show="minimized"
                  Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\crsp\Installed" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Tells the updater how this copy was installed (CRSP19): the text "msi". Removed with the product. -->
      <Component Id="InstallKind">
        <File Id="InstallKindFile" Name="install-kind" Source="install-kind" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!--
      %ProgramData%\crsp, made by the MSI with its ACL as SDDL (Windows
      Installer 5 PermissionEx): owned by Administrators, protected from the
      inherited rights that let every user create files, full control for
      Administrators and SYSTEM (the service runs as LocalSystem). The key path is a value
      under HKLM, which every account can read.
    -->
    <ComponentGroup Id="DataFolder" Directory="DATAFOLDER">
      <Component Id="DataFolderComponent">
        <CreateFolder>
          <PermissionEx Sddl="O:BAD:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\crsp\Installed" Name="DataFolder" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      One entry in Settings > Apps: the package's own (ProductCode, written by Windows
      Installer). Every major upgrade replaces it. An earlier build also wrote a second,
      hand-made key (Uninstall\crsp) and hid its own with ARPSYSTEMCOMPONENT; a machine
      could then show the program twice (CRSP147), so neither is authored any more.
    -->

    <!--
      Remove (OPS69). An interactive uninstall asks every time, with no default, through the native
      window `crsp lifecycle-window remove` (TRAY12): it exits 10 for Keep my data, 11 for Delete my
      data too and 1 for Cancel. `crsp uninstall option ask-to FILE` calls it and writes the answer to FILE;
      a cancel ends the uninstall with nothing changed. Silently, `msiexec /x <msi> /qn` keeps the data;
      PURGE=1 deletes it (REMOVEDATA=1, the older name, is the same). A major upgrade never removes it
      (UPGRADINGPRODUCTCODE is set while the old version is removed).
      Keeping or deleting, the runners are unregistered from GitHub first, while the controller still
      runs (UnregisterRunners, as the signed-in user), then `crsp uninstall option from-installer` stops what
      is left, deletes everything crsp made when asked (settings, database, logs, caches, runner images,
      containers and the crsp WSL distro) and writes the audit row with actor and result. The program,
      the service and the other entries are removed by this package.
    -->
    <Property Id="PURGE" Value="0" Secure="yes" />
    <Property Id="PURGEARG" Value=" " />
    <Property Id="REMOVEDATA" Value="0" Secure="yes" />
    <SetProperty Id="PURGE" Value="1" After="AppSearch" Sequence="both" Condition="REMOVEDATA=&quot;1&quot;" />
    <SetProperty Id="PURGEARG" Value="--delete-data " After="SetPURGE" Sequence="both" Condition="PURGE=&quot;1&quot; OR REMOVEDATA=&quot;1&quot;" />
    <SetProperty Id="CRSPEXE" Value="[INSTALLFOLDER]crsp.exe" After="CostFinalize" Sequence="both" />
    <SetProperty Id="CHOICEFILE" Value="[CommonAppDataFolder]crsp-remove-choice.txt" After="CostFinalize" Sequence="both" />

    <!-- WixQuietExec puts what a command prints into the MSI log. -->
    <SetProperty Id="StopServiceEarly"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$s = Get-Service -Name crsp -ErrorAction SilentlyContinue; if ($s -and $s.Status -ne 'Stopped') [\{] try [\{] $s.Stop(); $s.WaitForStatus('Stopped', '00:00:20') [\}] catch [\{] [\}] [\}]; $a = Get-CimInstance Win32_Service -Filter 'Name=''crsp-agent''' -ErrorAction SilentlyContinue; if ($a -and $a.State -eq 'Running' -and $a.PathName -like '*[INSTALLFOLDER]*') [\{] Stop-Service -Name crsp-agent -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force -Path '[DATAFOLDER]' | Out-Null; Set-Content -Path '[DATAFOLDER]agent-was-running.flag' -Value 1 [\}]&quot;"
                 Before="StopServiceEarly"
                 Sequence="execute" />
    <CustomAction Id="StopServiceEarly"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      The tray runs crsp.exe from the program folder as the signed-in user, so
      it holds the file the package replaces. After the service has stopped,
      anything still running from the program folder is ended and waited for,
      as SYSTEM, before a file is replaced or removed: otherwise the new file
      waits for a reboot. Only programs under this product's own folder.
    -->
    <SetProperty Id="EndProgramProcesses"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$folder = '[INSTALLFOLDER]'; Get-Process | Where-Object [\{] $_.Path -and $_.Path.StartsWith($folder, 'OrdinalIgnoreCase') [\}] | ForEach-Object [\{] try [\{] $_.Kill(); $_.WaitForExit(15000) | Out-Null [\}] catch [\{] [\}] [\}]&quot;"
                 Before="EndProgramProcesses"
                 Sequence="execute" />
    <CustomAction Id="EndProgramProcesses"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Closes the tray BEFORE InstallValidate (operations R5.86). The tray runs
      crsp.exe from the program folder in the signed-in user's session, so
      InstallValidate used to wait on it (the "Validating install" stall).
      The crsp service is stopped here too (waited at most 20 s), and so is the crsp-agent service when it runs from the program folder (at most 20 s; the agent-was-running.flag in [DATAFOLDER] is written first, as StopServiceEarly does, so StartServices2 starts it again), and what is still running from the program folder is ended, so no program is in use when InstallValidate looks (OPS50). It runs through WixQuietExec, so no console window shows. Each tray under the program folder is asked to quit like a window is
      (taskkill without /f posts WM_CLOSE, and the tray quits on it), waited for
      up to 5 s, and ended when it did not leave. It works with every older
      version, because it does not call the installed crsp.exe. Runs as the
      installing user (an elevated process in the user's session, so it can
      reach the user's tray); the SYSTEM auto-update reaches it through the
      forced end. Errors are ignored: EndProgramProcesses is the second pass.
    -->
    <!--
      WixQuietExec in an immediate action reads its command from the property
      WixQuietExecCmdLine (a deferred one reads CustomActionData) and runs it with
      no console window. The timeout is the whole of CloseTray: 5 s + 20 s + 20 s + the ends.
    -->
    <Property Id="WixQuietExecCmdTimeout" Value="90000" />
    <SetProperty Id="WixQuietExecCmdLine"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$f = '[INSTALLFOLDER]'; $t = @(Get-CimInstance Win32_Process -Filter 'Name=''crsp.exe''' -ErrorAction SilentlyContinue | Where-Object [\{] $_.ExecutablePath -and $_.ExecutablePath.StartsWith($f, 'OrdinalIgnoreCase') -and $_.CommandLine -match ' tray' [\}]); $t | ForEach-Object [\{] taskkill /pid $_.ProcessId 2&gt;&amp;1 | Out-Null [\}]; $end = (Get-Date).AddSeconds(5); while ((Get-Date) -lt $end -and ($t | Where-Object [\{] Get-Process -Id $_.ProcessId -ErrorAction SilentlyContinue [\}])) [\{] Start-Sleep -Milliseconds 200 [\}]; $t | ForEach-Object [\{] Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue [\}]; $s = Get-Service -Name crsp -ErrorAction SilentlyContinue; if ($s -and $s.Status -ne 'Stopped') [\{] try [\{] $s.Stop(); $s.WaitForStatus('Stopped', '00:00:20') [\}] catch [\{] [\}] [\}]; $a = Get-CimInstance Win32_Service -Filter 'Name=''crsp-agent''' -ErrorAction SilentlyContinue; if ($a -and $a.State -ne 'Stopped' -and $a.PathName -like '*[INSTALLFOLDER]*') [\{] New-Item -ItemType Directory -Force -Path '[DATAFOLDER]' | Out-Null; Set-Content -Path '[DATAFOLDER]agent-was-running.flag' -Value 1; try [\{] $g = Get-Service -Name crsp-agent; $g.Stop(); $g.WaitForStatus('Stopped', '00:00:20') [\}] catch [\{] [\}]; Get-Process | Where-Object [\{] $_.Path -and $_.Path.StartsWith($f, 'OrdinalIgnoreCase') -and $_.Id -ne $PID [\}] | ForEach-Object [\{] try [\{] $_.Kill(); $_.WaitForExit(5000) | Out-Null [\}] catch [\{] [\}] [\}] [\}]; exit 0&quot;"
                 Before="CloseTray"
                 Sequence="execute" />
    <CustomAction Id="CloseTray"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- The service is left running whatever the run did ("already running" is not a failure); the agent service is started again when this run stopped it. -->
    <SetProperty Id="StartServices2"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Start-Service -Name crsp -ErrorAction SilentlyContinue; if (Test-Path '[DATAFOLDER]agent-was-running.flag') [\{] Remove-Item '[DATAFOLDER]agent-was-running.flag' -Force; Start-Service -Name crsp-agent -ErrorAction SilentlyContinue [\}]&quot;"
                 Before="StartServices2"
                 Sequence="execute" />
    <CustomAction Id="StartServices2"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      The remove step, as SYSTEM, after the service has stopped and nothing runs from the program folder.
      PURGE=1 on the command line deletes; otherwise the answer the window gave (CHOICEFILE) decides; with
      neither, the data is kept. The actor of the audit row is the user who started the uninstall.
    -->
    <SetProperty Id="RemoveData"
                 Value="&quot;[INSTALLFOLDER]crsp.exe&quot; uninstall --from-installer --yes [PURGEARG]--actor &quot;[LogonUser]&quot; --choice-file &quot;[CHOICEFILE]&quot;"
                 Before="RemoveData"
                 Sequence="execute" />
    <CustomAction Id="RemoveData"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      The delete of the whole data folder, logs included, by the installer itself (a purge leaves nothing, LC-15).
      It runs late: after the service is stopped and deleted (a killed service is restarted by its failure
      action, which would make the folder again) and the files are removed, just before the installer removes
      the empty folder. It ends any crsp process left (the tray), then removes the folder and tries again for
      up to 15 s, because a file handle can outlive its process by a moment.
    -->
    <SetProperty Id="PurgeFolder"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Write-Output 'PurgeFolder: removing [DATAFOLDER]'; for ($i = 0; $i -lt 15; $i++) [\{] Get-Process -Name crsp -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Remove-Item -LiteralPath '[DATAFOLDER]' -Recurse -Force -ErrorAction Continue; if (-not (Test-Path -LiteralPath '[DATAFOLDER]')) [\{] break [\}]; Start-Sleep -Seconds 1 [\}]; Remove-Item -LiteralPath '[CHOICEFILE]' -Force -ErrorAction SilentlyContinue; if (Test-Path -LiteralPath '[DATAFOLDER]') [\{] Write-Output 'PurgeFolder: FAILED, left:'; Get-ChildItem -LiteralPath '[DATAFOLDER]' -Recurse -Force | ForEach-Object [\{] Write-Output $_.FullName [\}] [\}] else [\{] Write-Output 'PurgeFolder: done' [\}]; exit 0&quot;"
                 Before="PurgeFolder"
                 Sequence="execute" />
    <CustomAction Id="PurgeFolder"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      The runners are unregistered from GitHub before the service stops: the controller does it, so it must
      still run. This runs as the person who started the uninstall (their crsp login), before the tray and
      the service are closed. A machine with nobody signed in to crsp keeps the runners registered; the
      remove step says so in the audit row. It never blocks the uninstall.
    -->
    <CustomAction Id="UnregisterRunners"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]crsp.exe&quot; uninstall --runners-only"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!--
      The window that asks "Keep my data" or "Delete my data too" (TRAY12 builds it, `crsp lifecycle-window
      remove`; this runs it through `crsp uninstall option ask-to`). An interactive uninstall only: a silent
      one keeps the data, PURGE=1 deletes it. A cancel (exit 1) fails this action, so the uninstall ends
      with nothing changed.
    -->
    <CustomAction Id="AskRemove"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]crsp.exe&quot; uninstall --ask-to &quot;[CHOICEFILE]&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="check" />

    <!--
      A failed run rolls back: Windows Installer puts the old version back
      (service, files, rule, PATH), and this rollback action starts the old
      service again (and the agent service when this run stopped it, by the flag), because rollback does not start what it re-registers.
      Scheduled before StopServiceEarly, so it runs after everything else is undone.
    -->
    <SetProperty Id="StartServicesRollback"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Start-Service -Name crsp -ErrorAction SilentlyContinue; if (Test-Path '[DATAFOLDER]agent-was-running.flag') [\{] Remove-Item '[DATAFOLDER]agent-was-running.flag' -Force; Start-Service -Name crsp-agent -ErrorAction SilentlyContinue [\}]&quot;"
                 Before="StartServicesRollback"
                 Sequence="execute" />
    <CustomAction Id="StartServicesRollback"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />
    <?ifdef FailAfterInstall?>
    <!-- Test builds only (build.ps1 -FailAfterInstall): the run fails after the files are in, to test the rollback. -->
    <SetProperty Id="FailNow" Value="&quot;[System64Folder]cmd.exe&quot; /c exit 1" Before="FailNow" Sequence="execute" />
    <CustomAction Id="FailNow" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <?endif?>

    <!--
      Starts the tray for the person who installed, at the end of a successful
      install or upgrade (OPS6); until now it came back only at the next sign-in.
      The old tray was ended by EndProgramProcesses earlier in the same run, so
      this one is the only tray. Not elevated: the installer's own process may
      hold an administrator token, so the Start Menu shortcut is opened through
      explorer.exe, which starts it in the signed-in user's own (not elevated)
      session. The shortcut runs "crsp.exe tray". Runs after InstallFinalize, so
      after a rollback it never runs. Not on uninstall or repair (Installed),
      and not when the run is SYSTEM's (the auto-update from the service),
      which has no user session to show a tray in.
    -->
    <SetProperty Id="LaunchTrayExe" Value="[WindowsFolder]explorer.exe" After="CostFinalize" Sequence="both" />
    <CustomAction Id="LaunchTray"
                  Property="LaunchTrayExe"
                  ExeCommand="&quot;[ProgramMenuFolder]CI Runners Shared Pool.lnk&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="CloseTray" Before="InstallValidate" />
      <Custom Action="LaunchTray" After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE AND NOT (LogonUser~=&quot;SYSTEM&quot;)" />
      <Custom Action="StartServicesRollback" Before="StopServiceEarly" />
      <?ifdef FailAfterInstall?>
      <Custom Action="FailNow" After="StartServices2" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <?endif?>
      <!-- First of all, in every run: nothing holds the program's files from here on. -->
      <Custom Action="StopServiceEarly" After="RemoveExistingProducts" />
      <Custom Action="EndProgramProcesses" After="StopServices" />
      <Custom Action="StartServices2" After="StartServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterRunners" Before="CloseTray"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveData" After="EndProgramProcesses"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeFolder" After="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND PURGE=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- What the install window says for each step that can take a moment (operations R5.86). -->
    <UI>
      <ProgressText Action="CloseTray" Message="Closing the crsp tray" />
      <ProgressText Action="StopServiceEarly" Message="Stopping the crsp service" />
      <ProgressText Action="EndProgramProcesses" Message="Closing programs that use crsp files" />
      <ProgressText Action="StartServices2" Message="Starting the crsp service" />
      <ProgressText Action="UnregisterRunners" Message="Unregistering the runners from GitHub" />
      <ProgressText Action="RemoveData" Message="Removing crsp" />
      <ProgressText Action="PurgeFolder" Message="Removing the crsp data folder" />
    </UI>

    <!-- The dialogs: the minimal install page. The uninstall question is the native remove window (OPS69). -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- TRAY5 D12 / D17: the stock dialogs keep their layout; the art is ours. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- Interactive uninstall only (full or reduced UI, not a silent run, not an upgrade, PURGE not given). -->
    <InstallUISequence>
      <Custom Action="AskRemove" After="CostFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel&gt;=4 AND PURGE&lt;&gt;&quot;1&quot;" />
    </InstallUISequence>
  </Package>
</Wix>
