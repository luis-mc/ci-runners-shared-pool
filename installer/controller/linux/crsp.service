[Unit]
Description=CI Runners Shared Pool controller (crsp)
Documentation=https://github.com/luis-mc/ci-runners-shared-pool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/crsp controller
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
