{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/effort_drift.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/effort_drift.py\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/delivery/session_guard.py\" ] || exit 0; if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/scripts/delivery/session_guard.py\"; else python \"$CLAUDE_PROJECT_DIR/scripts/delivery/session_guard.py\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "luismc-project-setup@dev-standards": true,
    "luismc-agents@dev-standards": true,
    "luismc-audits@dev-standards": true,
    "luismc-delivery@dev-standards": true,
    "luismc-docs@dev-standards": true,
    "luismc-transcript-folds@dev-standards": true
  },
  "extraKnownMarketplaces": {
    "dev-standards": {
      "source": {
        "source": "github",
        "repo": "luis-mc/dev-standards"
      }
    }
  },
  "outputStyle": "Caveman",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)"
    ]
  }
}